node_modules
dist
out
.DS_Store
.eslintcache
*.log*
.codegraph
*.tsbuildinfo
*.key.pem

# Nextflow run artifacts left behind by testing wrapper/subworkflow/workflow
# adapters under resources/wrappers/ — not something to ship or commit.
resources/wrappers/**/work/
resources/wrappers/**/results/
resources/wrappers/**/.nextflow/

# Generated by `npm run wrappers:index` during `npm run build`; pack.json is
# the committed source of the pack's name and version.
resources/wrappers/index.json

# Micromamba binaries downloaded by `npm run runtime:fetch`. Version, URL, and
# sha256 live in resources/runtime/manifest.json, which is committed.
resources/runtime/micromamba/

# OfficeCLI binaries downloaded by `bun run office:fetch`. Version, URL, and sha256
# live in resources/office/manifest.json, which is committed.
resources/office/officecli/

# Local agent-tool runtime state (progress tracking, screenshots) — not
# project source.
.omx/

# Local db-vs-fetch evaluation results (scripts/eval/).
eval-results/

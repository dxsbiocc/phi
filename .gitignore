# Micromamba binaries downloaded by `bun run runtime:fetch`. Version, URL, and
# sha256 live in resources/runtime/manifest.json, which is committed.
resources/runtime/micromamba/

# Bun binaries downloaded by `bun run bun:fetch`. Version, archive sha256, and
# extracted executable sha256 live in resources/runtime/manifest.json.
resources/runtime/bun/

# Remote helper binaries and their generated checksum manifest are produced by
# `bun run build:helper`; source and the canonical version remain tracked.
resources/remote-helper/

# OfficeCLI binaries downloaded by `bun run office:fetch`. Version, URL, and sha256
# live in resources/office/manifest.json, which is committed.
resources/office/officecli/

# Local agent-tool runtime state (progress tracking, screenshots) — not
# project source.
.omx/

# Local db-vs-fetch evaluation results (scripts/eval/).
eval-results/

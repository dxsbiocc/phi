+/** Phi: the arguments the local `task` tool needs for a Cursor built-in Task call. */
+export function cursorSubagentTaskArgs(subagentType: string, prompt: string): Record<string, unknown> {
+	return {
+		agent: subagentType === "explore" ? "scout" : "task",
+		task: prompt,
+		solutionSpace: "Open: decide the approach from the assignment.",
+	};
+}
+
+function toolResultText(toolResult: ToolResultMessage): string {
+	return toolResult.content.map(block => (block.type === "text" ? block.text : "")).join("");
+}
+
+function buildSubagentError(error: string): SubagentResult {
+	return create(SubagentResultSchema, { result: { case: "error", value: create(SubagentErrorSchema, { error }) } });
+}
+
+function buildSubagentResultFromToolResult(agentId: string, toolResult: ToolResultMessage): SubagentResult {
+	const text = toolResultText(toolResult);
+	if (toolResult.isError) return buildSubagentError(text);
+	return create(SubagentResultSchema, {
+		result: { case: "success", value: create(SubagentSuccessSchema, { agentId, finalMessage: text }) },
+	});
+}
+
+function buildSubagentAwaitError(agentId: string, error: string): SubagentAwaitResult {
+	return create(SubagentAwaitResultSchema, {
+		result: { case: "error", value: create(SubagentAwaitErrorSchema, { agentId, error }) },
+	});
+}
+
+function buildSubagentAwaitResultFromToolResult(agentId: string, toolResult: ToolResultMessage): SubagentAwaitResult {
+	const text = toolResultText(toolResult);
+	if (toolResult.isError) return buildSubagentAwaitError(agentId, text);
+	return create(SubagentAwaitResultSchema, {
+		result: { case: "complete", value: create(SubagentAwaitCompleteSchema, { agentId, finalMessage: text }) },
+	});
+}

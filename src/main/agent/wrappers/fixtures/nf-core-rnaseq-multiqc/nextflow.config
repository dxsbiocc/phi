// Minimal launcher config for the standalone MULTIQC wrapper — not
// nf-core/rnaseq's own nextflow.config (that one wires up 40+ modules'
// worth of resource labels/container settings this wrapper doesn't need).
params {
    input  = null
    outdir = null
}

// See ../nf-core-rnaseq-fastqc/nextflow.config's comment on this block —
// nf-core modules declare bare container refs (implicitly docker.io);
// quay.io mirrors the same images and is what nf-core/rnaseq's own
// nextflow.config points at.
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

process {
    cpus   = 1
    memory = '4.GB'
    time   = '1.h'

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
}

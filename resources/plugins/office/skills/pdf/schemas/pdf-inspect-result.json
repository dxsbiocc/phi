{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file",
    "pageCount",
    "encrypted",
    "pagesTruncated",
    "pages",
    "metadata",
    "metadataTruncated"
  ],
  "properties": {
    "file": { "type": "string" },
    "pageCount": { "type": ["integer", "null"], "minimum": 0 },
    "encrypted": { "type": "boolean" },
    "pagesTruncated": { "type": "boolean" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "textCharacters"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "textCharacters": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "maxLength": 100 },
      "additionalProperties": { "type": "string", "maxLength": 500 }
    },
    "metadataTruncated": { "type": "boolean" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phi.local/skills/omics-visualization/viz-examples.json",
  "title": "viz examples result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "source",
    "dataFitted",
    "totalMatches",
    "candidates"
  ],
  "properties": {
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "const": "bundled-template-preview"
    },
    "dataFitted": {
      "const": false
    },
    "totalMatches": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_id",
          "title",
          "family",
          "preview",
          "preview_markdown",
          "use_when",
          "avoid_when",
          "required_roles"
        ],
        "properties": {
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "preview": {
            "type": "string",
            "minLength": 1
          },
          "preview_markdown": {
            "type": "string",
            "minLength": 1
          },
          "use_when": {
            "type": "string"
          },
          "avoid_when": {
            "type": "string"
          },
          "required_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phi.local/skills/omics-visualization/viz-prepare.json",
  "title": "viz prepare result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "script",
    "purpose",
    "inputs",
    "run",
    "dependencies"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "existing": {
      "const": true
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "purpose": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adaptation": {
      "type": "string"
    },
    "assumptions": {
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/section"
    },
    "data_preparation": {
      "$ref": "#/$defs/section"
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line",
        "text"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}

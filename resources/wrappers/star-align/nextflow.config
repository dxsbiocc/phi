// Minimal launcher config for the standalone STAR align wrapper — not
// nf-core/rnaseq's own nextflow.config (that one wires up 40+ modules'
// worth of resource labels/container settings this wrapper doesn't need).
params {
    reads  = null
    fasta  = null
    gtf    = null
    outdir = null
}

// See ../fastqc/nextflow.config's comment on this block —
// nf-core modules declare bare container refs (implicitly docker.io);
// quay.io mirrors the same images and is what nf-core/rnaseq's own
// nextflow.config points at.
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

process {
    cpus   = 8
    memory = '32.GB'
    time   = '8.h'

    withName: 'STAR_GENOMEGENERATE' {
        publishDir = [
            path: { "${params.outdir}/star_index" },
            mode: 'copy'
        ]
    }
    withName: 'STAR_ALIGN' {
        // Verified necessary against a real gzipped fastq: without this,
        // STAR reads the .gz bytes as plain text and fails with "wrong
        // read ID line format" instead of decompressing on the fly.
        // nf-core/rnaseq's own conf/modules/align_star.config sets the
        // same flag for the same reason.
        ext.args = '--readFilesCommand zcat'
        publishDir = [
            path: { "${params.outdir}/star_align/${meta.id}" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
}

// Minimal launcher config for the standalone Salmon quant wrapper — not
// nf-core/rnaseq's own nextflow.config (that one wires up 40+ modules'
// worth of resource labels/container settings this wrapper doesn't need).
params {
    reads  = null
    fasta  = null
    gtf    = null
    outdir = null
}

// See ../fastqc/nextflow.config's comment on this block —
// nf-core modules declare bare container refs (implicitly docker.io);
// quay.io mirrors the same images and is what nf-core/rnaseq's own
// nextflow.config points at.
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

process {
    cpus   = 4
    memory = '16.GB'
    time   = '4.h'

    withName: 'GFFREAD' {
        // "-w" is what tells gffread to emit a transcript FASTA rather
        // than a filtered GTF/GFF3/BED — see the module's own script
        // block, which picks the output type from these flags.
        ext.args = '-w'
        // Explicit prefix, not the module's meta.id-derived default:
        // verified necessary when the input genome fasta happens to be
        // named the same as the meta id gffread would default to (e.g.
        // "genome.fasta") — the module refuses to run rather than
        // overwrite its own input ("Input and output names are the same,
        // use task.ext.prefix to disambiguate").
        ext.prefix = 'transcripts'
    }
    withName: 'SALMON_INDEX' {
        publishDir = [
            path: { "${params.outdir}/salmon_index" },
            mode: 'copy'
        ]
    }
    withName: 'SALMON_QUANT' {
        publishDir = [
            path: { "${params.outdir}/salmon_quant" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
}

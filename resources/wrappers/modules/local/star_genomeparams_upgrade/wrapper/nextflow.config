// Launcher config for the STAR genomeParameters upgrade wrapper adapter.
// Not part of the fixed wrapper/{main.nf,params.json,wrapper.yaml}
// contract — Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 2
    memory = '6.GB'
    time   = '1.h'

    withName: 'STAR_GENOMEPARAMS_UPGRADE' {
        publishDir = [
            path: { "${params.outdir}/star_genomeparams_upgrade" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the top-DE-gene heatmap wrapper adapter. Not part of
// the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract -- Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.
//
// No docker/singularity registry override needed: ../main.nf already
// declares a fully-qualified container ref (the same one proven in
// ../../qc/main.nf).
//
// Every option below is read by the ext.args/ext.prefix closures, which
// Nextflow evaluates before wrapper/main.nf's own `params.x = default`
// lines run -- so each must also be defaulted here (see create-wrapper
// skill). DE_HEATMAP takes bare `path` inputs (no meta map), so
// ext.prefix must be wired explicitly, same as ../../visualization/pca.
params.gene_id_col   = 'gene_id'
params.sample_id_col = 'sample'
params.annotate_by   = 'condition'
params.top_n         = '50'
params.scale_rows    = true
params.prefix        = 'de'

process {
    cpus   = 1
    memory = '2.GB'
    time   = '20.min'

    withName: 'DE_HEATMAP' {
        ext.prefix = { params.prefix }
        ext.args = {
            "--gene_id_col ${params.gene_id_col} --sample_id_col ${params.sample_id_col} " +
            "--annotate_by ${params.annotate_by} --top_n ${params.top_n} --scale_rows ${params.scale_rows ? 'TRUE' : 'FALSE'}"
        }
        publishDir = [
            path: { "${params.outdir}/heatmap" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

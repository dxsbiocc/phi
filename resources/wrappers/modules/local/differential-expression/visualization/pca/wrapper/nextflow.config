// Launcher config for the PCA-plot wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract -- Nextflow picks
// this up automatically because it sits beside wrapper/main.nf.
//
// No docker/singularity registry override needed: ../main.nf already
// declares a fully-qualified container ref (the same one proven in
// ../../qc/main.nf).
//
// Every option below is read by the ext.args/ext.prefix closures, which
// Nextflow evaluates before wrapper/main.nf's own `params.x = default`
// lines run -- so each must also be defaulted here (see create-wrapper
// skill). DE_PCA takes bare `path` inputs (no meta map), so ext.prefix
// must be wired explicitly, same as ../../visualization/volcano.
params.gene_id_col   = 'gene_id'
params.sample_id_col = 'sample'
params.color_by      = 'condition'
params.shape_by      = 'null'
params.ntop          = '500'
params.prefix        = 'de'

process {
    cpus   = 1
    memory = '2.GB'
    time   = '20.min'

    withName: 'DE_PCA' {
        ext.prefix = { params.prefix }
        ext.args = {
            "--gene_id_col ${params.gene_id_col} --sample_id_col ${params.sample_id_col} " +
            "--color_by ${params.color_by} --shape_by ${params.shape_by} --ntop ${params.ntop}"
        }
        publishDir = [
            path: { "${params.outdir}/pca" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

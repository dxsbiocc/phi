// Launcher config for the limma differential-expression wrapper adapter.
// Not part of the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract —
// Nextflow picks this up automatically because it sits beside wrapper/main.nf.
//
// No docker/singularity registry override needed: ../main.nf already
// declares a fully-qualified Wave container ref, matching bioconductor-edger
// + bioconductor-limma at the exact versions pinned in ../environment.yml
// (the module runs limma-voom for RNA-seq counts via edgeR::DGEList, or
// classic limma for continuous intensities — see use_voom below).
//
// sample_id_col/gene_id_col/use_voom are read by the ext.args closure below,
// which Nextflow evaluates before wrapper/main.nf's own `params.x = default`
// lines run — so they must also be defaulted here (see create-wrapper skill).
params.sample_id_col = 'sample'
params.gene_id_col   = 'gene_id'
params.use_voom      = true

process {
    cpus   = 2
    memory = '4.GB'
    time   = '30.min'

    withName: 'LIMMA_DIFFERENTIAL' {
        ext.args = {
            // The module's own option is `probe_id_col`, named for its
            // microarray origins — `gene_id_col` here is just this adapter's
            // more RNA-seq-friendly param name for the same thing.
            "--sample_id_col ${params.sample_id_col} --probe_id_col ${params.gene_id_col} --use_voom ${params.use_voom ? 'TRUE' : 'FALSE'}"
        }
        publishDir = [
            path: { "${params.outdir}/limma_differential" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

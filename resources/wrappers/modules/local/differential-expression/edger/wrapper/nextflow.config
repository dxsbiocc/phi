// Launcher config for the edgeR differential-expression wrapper adapter.
// Not part of the fixed wrapper/{main.nf,params.json,wrapper.yaml}
// contract -- Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.
//
// No docker/singularity registry override needed: ../main.nf already
// declares a fully-qualified container ref (reused from ../../limma/,
// which already bundles bioconductor-edger).
//
// Every option below is read by the ext.args/ext.prefix closures, which
// Nextflow evaluates before wrapper/main.nf's own `params.x = default`
// lines run -- so each must also be defaulted here (see create-wrapper
// skill). EDGER_DIFFERENTIAL takes bare `path` inputs (no meta map), so
// ext.prefix must be wired explicitly, same as ../visualization/*.
params.contrast_variable = 'null'
params.reference_level   = 'null'
params.target_level      = 'null'
params.formula           = 'null'
params.comparison        = 'null'
params.sample_id_col     = 'sample'
params.gene_id_col       = 'gene_id'
params.prefix             = 'de'

process {
    cpus   = 2
    memory = '4.GB'
    time   = '30.min'

    withName: 'EDGER_DIFFERENTIAL' {
        ext.prefix = { params.prefix }
        ext.args = {
            "--contrast_variable ${params.contrast_variable} --reference_level ${params.reference_level} " +
            "--target_level ${params.target_level} --formula ${params.formula} --contrast_string ${params.comparison} " +
            "--sample_id_col ${params.sample_id_col} --gene_id_col ${params.gene_id_col}"
        }
        publishDir = [
            path: { "${params.outdir}/edger_differential" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

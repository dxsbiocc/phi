// Launcher config for the DESeq2 QC wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.
//
// No docker/singularity registry override needed: ../main.nf already
// declares a fully-qualified Wave container ref matching ../environment.yml.
//
// vst is read by the ext.args closure below, which Nextflow evaluates before
// wrapper/main.nf's own `params.x = default` lines run — so it must also be
// defaulted here (see create-wrapper skill).
params.vst = false

process {
    cpus   = 2
    memory = '4.GB'
    time   = '30.min'

    withName: 'DESEQ2_QC' {
        ext.args = { params.vst ? '--vst TRUE' : '' }
        publishDir = [
            path: { "${params.outdir}/deseq2_qc" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

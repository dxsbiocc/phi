// Launcher config for the Preprocess GENCODE transcripts FASTA wrapper
// adapter. Not part of the fixed wrapper/{main.nf,params.json,wrapper.yaml}
// contract — Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 1
    memory = '1.GB'
    time   = '15.min'

    withName: 'PREPROCESS_TRANSCRIPTS_FASTA_GENCODE' {
        // ../main.nf's docker container reference ("nf-core/ubuntu:20.04",
        // no registry host) doesn't resolve to a real pullable image —
        // this is the same image with the registry host it's missing.
        container = 'quay.io/nf-core/ubuntu:20.04'
        publishDir = [
            path: { "${params.outdir}/preprocess_transcripts_fasta_gencode" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

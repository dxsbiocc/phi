// Launcher config for the Bracken wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

params.read_len  = 150
params.level     = 'S'
params.threshold = 10

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'BRACKEN_BRACKEN' {
        ext.args = { "-l ${params.level} -t ${params.threshold} -r ${params.read_len}" }
        publishDir = [
            path: { "${params.outdir}/bracken" },
            mode: 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the bracken/combinebrackenoutputs wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '30.min'

    withName: 'BRACKEN_BRACKEN' {
        ext.args = '-l S -t 10 -r 150'
    }

    withName: 'BRACKEN_COMBINEBRACKENOUTPUTS' {
        publishDir = [
            path: { "${params.outdir}/bracken_combinebrackenoutputs" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the cnvnator/cnvnator wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '3.GB'
    time   = '30.min'

    withName: 'CNVNATOR_RD' {
        ext.args = '-chrom chr22'
    }

    withName: 'CNVNATOR_HIST' {
        ext.args = '-his 1000'
    }

    withName: 'CNVNATOR_STAT' {
        ext.args = '-stat 1000'
    }

    withName: 'CNVNATOR_PARTITION' {
        ext.args = '-partition 1000'
    }

    withName: 'CNVNATOR_CNVNATOR' {
        ext.args = '-call 1000'
        publishDir = [
            path: { "${params.outdir}/cnvnator_cnvnator" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

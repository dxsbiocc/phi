// Launcher config for the ctatsplicing/startocancerintrons wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '6.GB'
    time   = '30.min'

    withName: 'STAR_ALIGN' {
        ext.args = '--readFilesCommand zcat --outSAMtype BAM SortedByCoordinate --outReadsUnmapped None --twopassMode None --outSAMstrandField intronMotif --outSAMunmapped Within --chimSegmentMin 12 --chimJunctionOverhangMin 8 --chimOutJunctionFormat 1 --alignSJDBoverhangMin 10 --alignMatesGapMax 100000 --alignIntronMax 100000 --alignSJstitchMismatchNmax 5 -1 5 5 --chimMultimapScoreRange 3 --chimScoreJunctionNonGTAG -4 --chimMultimapNmax 20 --chimNonchimScoreDropMin 10 --peOverlapNbasesMin 12 --peOverlapMMp 0.1 --alignInsertionFlush Right --alignSplicedMateMapLminOverLmate 0 --alignSplicedMateMapLmin 30'
    }

    withName: 'CTATSPLICING_STARTOCANCERINTRONS' {
        ext.args = '--min_total_reads 1 --vis'
        publishDir = [
            path: { "${params.outdir}/ctatsplicing_startocancerintrons" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

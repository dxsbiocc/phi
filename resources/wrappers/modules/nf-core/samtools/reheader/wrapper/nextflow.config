// Launcher config for the samtools/reheader wrapper adapter. Not part
// of the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract —
// Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '30.min'

    withName: 'SAMTOOLS_REHEADER' {
        // A no-op passthrough edit — reheader requires -h/--command, and
        // this thin adapter doesn't surface a header-edit param.
        ext.args   = "--command 'cat'"
        ext.prefix = { "${meta.id}_reheaded" }
        publishDir = [
            path: { "${params.outdir}/samtools_reheader" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

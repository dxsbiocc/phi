// Launcher config for the samtools/markdup wrapper adapter. Not part of
// the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract —
// Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 2
    memory = '3.GB'
    time   = '30.min'

    withName: 'SAMTOOLS_FIXMATE' {
        ext.prefix = { "${meta.id}_fixmate" }
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}_sorted" }
    }

    withName: 'SAMTOOLS_MARKDUP' {
        // Distinct from SAMTOOLS_SORT's own output name, or Nextflow
        // excludes the (identically-named) output from the result glob.
        ext.prefix = { "${meta.id}_markdup" }
        publishDir = [
            path: { "${params.outdir}/samtools_markdup" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

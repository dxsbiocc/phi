// Launcher config for the bcftools/pluginimputeinfo wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '3.GB'
    time   = '30.min'

    withName: 'BCFTOOLS_PLUGINTAG2TAG' {
        ext.prefix = { "${meta.id}_gp" }
        ext.args = '--output-type z --write-index=tbi --no-version'
        ext.args2 = '--PL-to-GP'
    }

    withName: 'BCFTOOLS_PLUGINIMPUTEINFO' {
        ext.prefix = { "${meta.id}_vcf" }
        ext.args = '--no-version --output-type v'
        publishDir = [
            path: { "${params.outdir}/bcftools_pluginimputeinfo" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

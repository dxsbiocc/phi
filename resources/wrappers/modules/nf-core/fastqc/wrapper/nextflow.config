// Launcher config for the FastQC wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract in
// docs/design/phi-wrapper-agent-composition-design.md — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf, the same way
// nf-core pipelines keep a nextflow.config beside their own main.nf.
//
// No docker/singularity registry override needed: ../main.nf (refreshed
// from nf-core/modules master) already declares fully-qualified container
// refs (quay.io/biocontainers/..., community.wave.seqera.io/...), unlike
// the older vendored snapshot this replaced.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: 'copy',
            pattern: '*.{html,zip}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the bedtools/slop wrapper adapter. Not part of the
// fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '30.min'

    withName: 'BEDTOOLS_SLOP' {
        // slop requires an explicit extension amount (-b, or -l/-r).
        ext.args   = '-b 10'
        publishDir = [
            path: { "${params.outdir}/bedtools_slop" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the SeqKit replace wrapper adapter. Not part of the
// fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.

params.pattern     = 'A'
params.replacement = 'N'

process {
    cpus   = 1
    memory = '2.GB'
    time   = '30.min'

    withName: 'SEQKIT_REPLACE' {
        ext.args = { "-s -p '${params.pattern}' -r '${params.replacement}'" }
        publishDir = [
            path: { "${params.outdir}/seqkit_replace" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

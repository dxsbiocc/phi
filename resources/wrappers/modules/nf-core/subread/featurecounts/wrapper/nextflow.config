// Launcher config for the featureCounts wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

// Default for a param the ext.args closure below reads: a default set only in
// main.nf is invisible to config closures (they'd see null -> `-t null`).
// A params file still overrides this.
params.feature_type = 'exon'

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'SUBREAD_FEATURECOUNTS' {
        ext.args   = { "-t ${params.feature_type}" }
        publishDir = [
            path: { "${params.outdir}/featurecounts" },
            mode: 'copy',
            pattern: '*featureCounts.tsv*'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

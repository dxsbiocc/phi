// Launcher config for the RSEM_CALCULATEEXPRESSION wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.
//
// Both processes use --star (via ext.args), not RSEM's own bowtie
// aligner: a real run with plain bowtie defaults against this same test
// data failed ("fail to read the header from -" — bowtie produced no
// usable alignment stream). nf-core's own module test for this exact
// fastq test data hits the same thing and works around it the same way
// (see rsem/calculateexpression/tests/nextflow.config upstream) — this
// isn't a wrapper-specific workaround.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '30.min'

    withName: 'RSEM_PREPAREREFERENCE' {
        ext.args = '--star'
    }

    withName: 'RSEM_CALCULATEEXPRESSION' {
        ext.args = '--star --star-gzipped-read-file'
        publishDir = [
            path: { "${params.outdir}/rsem_calculateexpression" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

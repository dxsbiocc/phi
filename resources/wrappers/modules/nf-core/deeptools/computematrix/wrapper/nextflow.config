// Launcher config for the deeptools/computematrix wrapper adapter. Not
// part of the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract
// — Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'DEEPTOOLS_COMPUTEMATRIX' {
        // computeMatrix requires a mode as its first positional
        // argument (scale-regions or reference-point) — the vendored
        // module passes task.ext.args first on its command line for
        // exactly this, so it must be set here or the tool errors.
        ext.args   = 'scale-regions'
        publishDir = [
            path: { "${params.outdir}/deeptools_computematrix" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

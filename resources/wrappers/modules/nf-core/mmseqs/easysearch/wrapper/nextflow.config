// Launcher config for the mmseqs/easysearch wrapper adapter. Not part of
// the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract —
// Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'MMSEQS_EASYSEARCH' {
        // Both query and target are nucleotide FASTA here; mmseqs can't
        // infer that automatically and errors without an explicit type.
        // The default k-mer length (15) for nucleotide indexing has a
        // large *fixed* memory cost (independent of database size) that
        // mmseqs refuses to allocate inside this container regardless
        // of --split/--split-memory-limit. A short k-mer (appropriate
        // for tiny toy sequences anyway) avoids that fixed cost.
        ext.args   = '--search-type 3 -s 1 -k 7'
        publishDir = [
            path: { "${params.outdir}/mmseqs_easysearch" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the mmseqs/search wrapper adapter. Not part of
// the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract —
// Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'MMSEQS_SEARCH' {
        // Distinct from either input database's own directory name, or
        // Nextflow excludes the (identically-named) output from the
        // result glob. Short k-mer avoids mmseqs' fixed-cost nucleotide
        // index memory estimate — see mmseqs-easysearch for why.
        ext.args   = '--search-type 3 -s 1 -k 7'
        ext.prefix = 'search_out'
        publishDir = [
            path: { "${params.outdir}/mmseqs_search" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the mmseqs/cluster wrapper adapter. Not part of
// the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract —
// Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'MMSEQS_CLUSTER' {
        // The default k-mer length (15) for nucleotide indexing has a
        // large *fixed* memory cost (independent of database size) that
        // mmseqs refuses to allocate inside this container regardless
        // of --split/--split-memory-limit. A short k-mer (appropriate
        // for tiny toy sequences anyway) avoids that fixed cost.
        ext.args   = '-s 1 -k 7'
        publishDir = [
            path: { "${params.outdir}/mmseqs_cluster" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

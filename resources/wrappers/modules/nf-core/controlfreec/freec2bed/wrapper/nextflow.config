// Launcher config for the controlfreec/freec2bed wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '30.min'

    withName: 'CONTROLFREEC_FREEC' {
        ext.args = { ["sample": [inputformat: 'pileup', mateorientation: 'FR'], "general": [bedgraphoutput: "TRUE", noisydata: "TRUE", minexpectedgc: "0", readcountthreshold: "1", sex: meta.sex, window: "10"], "control": [inputformat: "pileup", mateorientation: "FR"]] }
    }

    withName: 'CONTROLFREEC_FREEC2BED' {
        publishDir = [
            path: { "${params.outdir}/controlfreec_freec2bed" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

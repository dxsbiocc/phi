// Launcher config for the gatk4/postprocessgermlinecnvcalls wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '6.GB'
    time   = '30.min'

    withName: 'GATK4_COLLECTREADCOUNTS' {
        ext.args = '--format TSV --interval-merging-rule OVERLAPPING_ONLY'
    }

    withName: 'GATK4_DETERMINEGERMLINECONTIGPLOIDY' {
        ext.args = '--interval-merging-rule OVERLAPPING_ONLY'
        ext.prefix = 'ploidy'
    }

    withName: 'GATK4_GERMLINECNVCALLER' {
        ext.args = '--interval-merging-rule OVERLAPPING_ONLY --run-mode COHORT'
    }

    withName: 'GATK4_POSTPROCESSGERMLINECNVCALLS' {
        publishDir = [
            path: { "${params.outdir}/gatk4_postprocessgermlinecnvcalls" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

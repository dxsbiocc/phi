// Launcher config for the gatk4/sitedepthtobaf wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '4.GB'
    time   = '30.min'

    withName: 'GATK4_COLLECTSVEVIDENCE' {
        ext.args = { "--sample-name ${meta.id}" }
    }

    withName: 'GATK4_SITEDEPTHTOBAF' {
        publishDir = [
            path: { "${params.outdir}/gatk4_sitedepthtobaf" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the fq subsample wrapper adapter. Not part of the
// fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.

params.probability = 0.5

process {
    cpus   = 1
    memory = '2.GB'
    time   = '30.min'

    withName: 'FQ_SUBSAMPLE' {
        ext.args = { "--probability ${params.probability} -s 123" }
        publishDir = [
            path: { "${params.outdir}/fq_subsample" },
            mode: 'copy',
            pattern: '*.fastq.gz'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

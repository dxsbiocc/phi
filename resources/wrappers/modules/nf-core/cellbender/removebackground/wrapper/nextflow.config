// Launcher config for the CellBender remove background wrapper adapter.
// Not part of the fixed wrapper/{main.nf,params.json,wrapper.yaml}
// contract — Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

params.epochs = 5

process {
    cpus   = 2
    memory = '6.GB'
    time   = '1.h'

    withName: 'CELLBENDER_REMOVEBACKGROUND' {
        ext.args = { "--epochs ${params.epochs}" }
        publishDir = [
            path: { "${params.outdir}/cellbender_removebackground" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

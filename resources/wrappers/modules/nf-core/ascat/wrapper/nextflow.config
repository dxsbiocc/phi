// Launcher config for the ascat wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '30.min'

    withName: 'ASCAT' {
        ext.args = [gender: 'XY', genomeVersion: 'hg19', minCounts: '1', min_base_qual: '1', min_map_qual: '1', chrom_names: 'c("21")']
        publishDir = [
            path: { "${params.outdir}/ascat" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

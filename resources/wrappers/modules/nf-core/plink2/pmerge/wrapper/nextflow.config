// Launcher config for the plink2/pmerge wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '3.GB'
    time   = '30.min'

    withName: 'PLINK2_FILTER_PART1' {
        ext.args = '--chr 1 --from-bp 1 --to-bp 110'
    }

    withName: 'PLINK2_FILTER_PART2' {
        ext.args = '--chr 1 --from-bp 111 --to-bp 220'
    }

    withName: 'PLINK2_PMERGE' {
        ext.prefix = { "${meta.id}_pmerge" }
        publishDir = [
            path: { "${params.outdir}/plink2_pmerge" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

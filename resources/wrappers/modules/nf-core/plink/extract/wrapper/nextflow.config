// Launcher config for the plink/extract wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '3.GB'
    time   = '30.min'

    withName: 'PLINK_VCF' {
        ext.args = '--make-bed --set-missing-var-ids @:#:\\$1:\\$2'
    }

    withName: 'GAWK' {
        ext.suffix = 'txt'
        ext.args2 = '\'BEGIN {OFS="\t"} ($5$6 == "GC" || $5$6 == "CG" || $5$6 == "AT" || $5$6 == "TA") {print $2}\''
    }

    withName: 'PLINK_EXTRACT' {
        ext.prefix = { "${meta.id}_extract" }
        publishDir = [
            path: { "${params.outdir}/plink_extract" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

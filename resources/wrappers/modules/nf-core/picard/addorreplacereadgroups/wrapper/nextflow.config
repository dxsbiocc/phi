// Launcher config for the picard/addorreplacereadgroups wrapper
// adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks
// this up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '3.GB'
    time   = '30.min'

    withName: 'PICARD_ADDORREPLACEREADGROUPS' {
        // RGID/RGLB/RGPL/RGPU/RGSM have no defaults and are required.
        ext.args   = '--RGID 1 --RGLB lib1 --RGPL ILLUMINA --RGPU barcode1 --RGSM test'
        publishDir = [
            path: { "${params.outdir}/picard_addorreplacereadgroups" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

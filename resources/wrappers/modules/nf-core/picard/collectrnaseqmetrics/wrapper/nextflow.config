// Launcher config for the picard/collectrnaseqmetrics wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '4.GB'
    time   = '30.min'

    withName: 'UCSC_GTFTOGENEPRED' {
        ext.args = '-genePredExt -geneNameAsName2 -ignoreGroupsWithoutExons'
    }

    withName: 'PICARD_COLLECTRNASEQMETRICS' {
        ext.args = '--STRAND_SPECIFICITY FIRST_READ_TRANSCRIPTION_STRAND'
        publishDir = [
            path: { "${params.outdir}/picard_collectrnaseqmetrics" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

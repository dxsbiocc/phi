// Launcher config for the gridss/generateponbedpe wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '6.GB'
    time   = '30.min'

    withName: 'GRIDSS_GENERATEPONBEDPE' {
        ext.args = 'NORMAL_ORDINAL=1 MIN_BREAKPOINT_QUAL=10'
        publishDir = [
            path: { "${params.outdir}/gridss_generateponbedpe" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

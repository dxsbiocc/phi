// Launcher config for the ucsc/bigwigaverageoverbed wrapper adapter. Not
// part of the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract
// — Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '30.min'

    withName: 'UCSC_BIGWIGAVERAGEOVERBED' {
        publishDir = [
            path: { "${params.outdir}/ucsc_bigwigaverageoverbed" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

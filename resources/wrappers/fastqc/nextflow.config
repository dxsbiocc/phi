// Minimal launcher config for the standalone FASTQC wrapper — not
// nf-core/rnaseq's own nextflow.config (that one wires up 40+ modules'
// worth of resource labels/container settings this wrapper doesn't need).
params {
    reads  = null
    outdir = null
}

// nf-core modules declare bare container refs like "biocontainers/fastqc:..."
// (implicitly docker.io) — quay.io mirrors the same biocontainers images
// and is what nf-core/rnaseq's own nextflow.config points at too. Verified
// necessary here: without it, this environment's docker.io mirror returned
// 403 for biocontainers/* on a real pull attempt.
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: 'copy',
            pattern: '*.{html,zip}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
}

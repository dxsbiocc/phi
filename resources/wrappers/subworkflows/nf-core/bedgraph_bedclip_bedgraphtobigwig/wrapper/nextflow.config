// Launcher config for the BedGraph to BigWig wrapper adapter. Not part of
// the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '30.min'

    publishDir = [
        path: { "${params.outdir}/bedgraph_bedclip_bedgraphtobigwig/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: 'copy'
    ]

    withName: 'UCSC_BEDCLIP' {
        ext.prefix = { "${meta.id}.clip" }
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

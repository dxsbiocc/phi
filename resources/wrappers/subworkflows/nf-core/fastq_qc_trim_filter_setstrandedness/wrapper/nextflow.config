// Launcher config for the fastq_qc_trim_filter_setstrandedness wrapper adapter.
// Not part of the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract —
// Nextflow picks this up automatically because it sits beside wrapper/main.nf.
//
// ext.* overrides mirror ../tests/nextflow.config and the real nf-core/rnaseq
// conf/modules/{qc_trim_filter,fastp,trimgalore}.config. The prefixes matter:
// FASTQC_RAW / FASTQC_TRIM and the two FQ_LINT runs would otherwise write
// identically named files into one place and overwrite each other.

// Defaults for params the closures below read. A `params.x = ...` default in
// main.nf is NOT visible to config closures (they see it as undefined -> null),
// so config-referenced params are defaulted here. A params file still overrides.
params.trimmer = 'fastp'

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'FQ_LINT' {
        publishDir = [ path: { "${params.outdir}/fastq_qc_trim_filter_setstrandedness/fq_lint/raw" }, mode: 'copy' ]
    }
    withName: 'FQ_LINT_AFTER_TRIMMING' {
        ext.prefix = { "${meta.id}.trimmed" }
        publishDir = [ path: { "${params.outdir}/fastq_qc_trim_filter_setstrandedness/fq_lint/trimmed" }, mode: 'copy' ]
    }

    withName: 'FASTQC_RAW|FASTQC' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_raw" }
        publishDir = [ path: { "${params.outdir}/fastq_qc_trim_filter_setstrandedness/fastqc/raw" }, mode: 'copy' ]
    }
    withName: 'FASTQC_TRIM' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_trimmed" }
        publishDir = [ path: { "${params.outdir}/fastq_qc_trim_filter_setstrandedness/fastqc/trim" }, mode: 'copy' ]
    }

    // Trimmed reads plus fastp's json/html/log reports, kept together.
    withName: 'FASTP' {
        publishDir = [ path: { "${params.outdir}/fastq_qc_trim_filter_setstrandedness/${params.trimmer}" }, mode: 'copy' ]
    }
    withName: 'TRIMGALORE' {
        cpus       = 2
        ext.args   = '--fastqc_args "-t 2"'
        ext.prefix = { "${meta.id}_trimmed" }
        publishDir = [
            [ path: { "${params.outdir}/fastq_qc_trim_filter_setstrandedness/fastqc/trim" }, mode: 'copy', pattern: '*.{html,zip}' ],
            [ path: { "${params.outdir}/fastq_qc_trim_filter_setstrandedness/${params.trimmer}" }, mode: 'copy', pattern: '*.{fq.gz,txt}' ]
        ]
    }

    // Strandedness inference: a sub-sample is quantified only to read the library
    // type, so nothing from these steps is published.
    withName: 'FQ_SUBSAMPLE' {
        ext.args   = '--record-count 1000000 --seed 1'
        ext.prefix = { "${meta.id}.subsampled" }
        publishDir = [ enabled: false ]
    }
    withName: 'SALMON_QUANT' {
        ext.args   = '--skipQuant --minAssignedFrags 1'
        publishDir = [ enabled: false ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the FASTQ subsample + Salmon quant wrapper adapter.
// Not part of the fixed wrapper/{main.nf,params.json,wrapper.yaml}
// contract — Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    // sarscov2's tiny test FASTQ has far fewer than 1000 reads, so keep
    // everything (probability 1.0) rather than requesting a fixed count.
    withName: 'FQ_SUBSAMPLE' {
        ext.args = '--probability 0.99 --seed 1'
    }

    publishDir = [
        path: { "${params.outdir}/fastq_subsample_fq_salmon/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: 'copy'
    ]
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

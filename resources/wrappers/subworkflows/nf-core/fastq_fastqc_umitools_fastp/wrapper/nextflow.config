// Launcher config for the FASTQ QC + UMI extract + fastp wrapper adapter.
// Not part of the fixed wrapper/{main.nf,params.json,wrapper.yaml}
// contract — Nextflow picks this up automatically because it sits beside
// wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'UMITOOLS_EXTRACT' {
        ext.args = '--bc-pattern="NNNN"'
    }

    // FASTQC_RAW and FASTQC_TRIM are the same process run twice on
    // differently-shaped but same-named input files; without distinct
    // prefixes their outputs collide (see the real rna-seq pipeline's own
    // fastp.config, which does the same thing).
    withName: 'FASTQC_RAW' {
        ext.prefix = { "${meta.id}_raw" }
    }
    withName: 'FASTQC_TRIM' {
        ext.prefix = { "${meta.id}_trimmed" }
    }

    publishDir = [
        path: { "${params.outdir}/fastq_fastqc_umitools_fastp/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: 'copy'
    ]
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

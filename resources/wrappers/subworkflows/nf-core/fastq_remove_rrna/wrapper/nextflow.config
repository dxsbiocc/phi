// Launcher config for the fastq_remove_rrna wrapper adapter. Not part of the
// fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks
// this up automatically because it sits beside wrapper/main.nf.
//
// ext.* overrides are copied from ../tests/nextflow.config: they pin the seeds
// and give each aliased instance its own file prefix.

process {
    cpus   = 2
    memory = '8.GB'
    time   = '2.h'

    withName: 'SORTMERNA' {
        ext.args = '--index 0'
    }
    withName: 'SORTMERNA_INDEX' {
        ext.args = '--index 1'
    }
    withName: 'RIBODETECTOR' {
        ext.prefix = { "${meta.id}.ribodetector" }
        ext.args   = '--seed 1'
    }
    withName: 'BOWTIE2_ALIGN|BOWTIE2_ALIGN_PE' {
        ext.prefix = { "${meta.id}.bowtie2_rrna" }
        ext.args   = '--very-sensitive-local --seed 1 --reorder'
    }
    withName: 'SAMTOOLS_VIEW_BOWTIE2' {
        ext.prefix = { "${meta.id}.bowtie2_unmapped" }
        ext.args   = '-f 12' // keep only pairs where BOTH mates are unmapped
    }
    withName: 'SAMTOOLS_FASTQ_BOWTIE2' {
        ext.prefix = { "${meta.id}.bowtie2_filtered" }
    }
    withName: 'SEQKIT_REPLACE' {
        ext.args   = '--pattern "^(.+)" --replacement "{fbn}_\\$1"'
        ext.prefix = { "${meta.id}_prefixed" }
    }
    withName: 'SEQKIT_REPLACE_U2T' {
        ext.args   = '--by-seq --pattern "[Uu]" --replacement "T"'
        ext.prefix = { "${meta.id}_converted" }
    }

    // Publish the depleted reads and each tool's log; indexes and the
    // intermediate BAM/FASTA steps stay in the work dir. SAMTOOLS_FASTQ also
    // writes (empty) *_other/*_singleton files, so only the _1/_2 pair is kept.
    withName: 'SORTMERNA|RIBODETECTOR|BOWTIE2_ALIGN|BOWTIE2_ALIGN_PE' {
        publishDir = [
            path: { "${params.outdir}/fastq_remove_rrna" },
            mode: 'copy',
            pattern: '*.{fastq.gz,log}'
        ]
    }
    withName: 'SAMTOOLS_FASTQ_BOWTIE2' {
        publishDir = [
            path: { "${params.outdir}/fastq_remove_rrna" },
            mode: 'copy',
            pattern: '*_{1,2}.fastq.gz'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

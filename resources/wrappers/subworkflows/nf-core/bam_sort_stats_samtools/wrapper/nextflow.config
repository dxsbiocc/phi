// Launcher config for the bam_sort_stats_samtools wrapper adapter. Not part of
// the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.
//
// Every process inside the subworkflow is a SAMTOOLS_* module, so one
// selector publishes their BAM, index and report files into a single dir.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: 'SAMTOOLS_.*' {
        publishDir = [
            path: { "${params.outdir}/bam_sort_stats_samtools" },
            mode: 'copy',
            pattern: '*.{bam,bai,stats,flagstat,idxstats}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

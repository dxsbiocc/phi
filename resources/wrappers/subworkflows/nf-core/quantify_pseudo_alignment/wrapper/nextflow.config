// Launcher config for the quantify_pseudo_alignment wrapper adapter. Not part
// of the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    // Same overrides as ../tests/nextflow.config: name the merged tximport /
    // SummarizedExperiment files and pick the assays the unified objects hold.
    withName: 'CUSTOM_TX2GENE' {
        ext.prefix = { "${quant_type}.merged" }
    }
    withName: 'TXIMETA_TXIMPORT' {
        ext.prefix = { "${quant_type}.merged" }
    }
    withName: 'SE_GENE_UNIFIED' {
        ext.prefix = { "${meta.id}_gene" }
        ext.args   = '--assay_names counts,counts_length_scaled,counts_scaled,lengths,tpm'
    }
    withName: 'SE_TRANSCRIPT_UNIFIED' {
        ext.prefix = { "${meta.id}_transcript" }
        ext.args   = '--assay_names counts,lengths,tpm'
    }

    // Publish the quantifier's per-sample results and every post-processing
    // product; the index-building steps stay in the work dir.
    withName: 'SALMON_QUANT|KALLISTO_QUANT|CUSTOM_TX2GENE|TXIMETA_TXIMPORT|SE_GENE_UNIFIED|SE_TRANSCRIPT_UNIFIED' {
        publishDir = [
            path: { "${params.outdir}/quantify_pseudo_alignment" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

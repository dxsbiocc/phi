// Launcher config for the fastq_align_hisat2 wrapper adapter. Not part of the
// fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks
// this up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    // Same override as ../tests/nextflow.config: HISAT2_ALIGN's BAM and the
    // sorted BAM would otherwise share a name.
    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
    }

    // Publish only the final products: HISAT2's summary log and the sorted
    // BAM/index/stats — not the unsorted intermediate BAM.
    withName: 'HISAT2_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/fastq_align_hisat2" },
            mode: 'copy',
            pattern: '*.log'
        ]
    }
    withName: 'SAMTOOLS_.*' {
        publishDir = [
            path: { "${params.outdir}/fastq_align_hisat2" },
            mode: 'copy',
            pattern: '*.{bam,bai,stats,flagstat,idxstats}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

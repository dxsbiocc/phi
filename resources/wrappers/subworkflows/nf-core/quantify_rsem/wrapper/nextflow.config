// Launcher config for the Quantify (RSEM) wrapper adapter. Not part of the
// fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    // Plain bowtie-based RSEM fails on this test data ("fail to read the
    // header from -" — bowtie produces no usable alignment stream); the
    // rsem/calculateexpression module wrapper hits the same thing and
    // works around it the same way nf-core's own module test does, by
    // using RSEM's --star mode instead.
    withName: 'RSEM_PREPAREREFERENCE' {
        ext.args = '--star'
    }
    withName: 'QUANTIFY_RSEM:RSEM_CALCULATEEXPRESSION' {
        ext.args = '--star --star-gzipped-read-file'
    }

    withName: 'SE_GENE_UNIFIED' {
        ext.prefix = { "${meta.id}_gene" }
        ext.args = '--assay_names counts,counts_length_scaled,counts_scaled,lengths,tpm'
    }
    withName: 'SE_TRANSCRIPT_UNIFIED' {
        ext.prefix = { "${meta.id}_transcript" }
        ext.args = '--assay_names counts,lengths,tpm'
    }

    publishDir = [
        path: { "${params.outdir}/quantify_rsem" },
        mode: 'copy'
    ]
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

// Launcher config for the Align with Bowtie2 wrapper adapter. Not part of
// the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    publishDir = [
        path: { "${params.outdir}/align_bowtie2" },
        mode: 'copy'
    ]
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

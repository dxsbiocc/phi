// Launcher config for the Align with STAR wrapper adapter. Not part of the
// fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow
// picks this up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '6.GB'
    time   = '1.h'

    // ../../modules/nf-core/star/align/main.nf only decompresses reads if
    // `--readFilesCommand zcat` is passed via ext.args — it does not
    // auto-detect gzip (same fix as the star/align module wrapper's own
    // nextflow.config). Without it, STAR reads the raw .gz bytes as text
    // and fails with a garbled "wrong read ID line format" error.
    withName: 'STAR_ALIGN' {
        ext.args = '--readFilesCommand zcat'
    }

    publishDir = [
        path: { "${params.outdir}/align_star" },
        mode: 'copy'
    ]
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}

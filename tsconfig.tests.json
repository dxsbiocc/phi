{
  "extends": "./tsconfig.node.json",
  "include": ["tests/**/*.ts", "src/renderer/src/env.d.ts", "src/preload/*.d.ts"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["electron-vite/node", "electron"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}

{
  "name": "pi-desktop",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "type": "module",
  "main": "./out/main/index.mjs",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "check:architecture": "node scripts/check-frontend-boundaries.mjs",
    "lint": "npm run check:architecture && eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "prestart": "npm run sync:electron-icon",
    "start": "electron-vite preview",
    "predev": "npm run sync:electron-icon",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run wrappers:index && electron-vite build",
    "sync:electron-icon": "node scripts/sync-electron-dev-icon.mjs",
    "postinstall": "electron-builder install-app-deps && npm run sync:electron-icon",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "node --import ./scripts/test-loader.mjs --test tests/*.test.ts",
    "smoke:wrappers": "node --import ./scripts/test-loader.mjs scripts/smoke-wrappers.mjs",
    "wrappers:index": "node --import ./scripts/test-loader.mjs scripts/build-wrapper-pack-index.mjs",
    "usage:report": "node --import ./scripts/test-loader.mjs scripts/agent-usage-report.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@oh-my-pi/pi-coding-agent": "18.1.10",
    "@rdkit/rdkit": "^2026.3.6",
    "@xyflow/react": "12.11.6",
    "ajv": "^8.20.0",
    "cytoscape": "^3.34.3",
    "glob": "13.0.6",
    "katex": "^0.18.7",
    "material-icon-theme": "^5.38.1",
    "molstar": "^5.11.0",
    "plotly.js-dist-min": "^4.1.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "^7.8.5",
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}

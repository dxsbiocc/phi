{
  "name": "pi-desktop",
  "version": "1.0.1",
  "description": "An Electron application with React and TypeScript",
  "type": "module",
  "main": "./out/main/index.mjs",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "check:architecture": "node scripts/check-frontend-boundaries.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "check:asar-unpack": "node scripts/check-asar-unpack.mjs",
    "check:connectors": "node --import ./scripts/test-loader.mjs scripts/content/check-connectors.ts",
    "check:skills": "node --import ./scripts/test-loader.mjs scripts/content/check-skills.ts",
    "check:agents": "node --import ./scripts/test-loader.mjs scripts/content/check-agents.ts",
    "check:plugins": "node --import ./scripts/test-loader.mjs scripts/content/check-plugins.ts",
    "check:package-content": "node scripts/content/check-package-content.mjs",
    "lint": "bun run check:architecture && bun run check:resources && bun run check:asar-unpack && bun run check:plugins && bun run check:skills && bun run check:agents && eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json --composite false",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web && bun run typecheck:scripts",
    "prestart": "bun run sync:electron-icon && bun run runtime:fetch && bun run office:fetch",
    "start": "electron-vite preview --skipBuild",
    "predev": "bun run sync:electron-icon && bun run runtime:fetch && bun run office:fetch",
    "dev": "electron-vite dev --watch",
    "build": "bun run typecheck && bun run runtime:fetch && bun run build:helper && bun run office:fetch && electron-vite build",
    "sync:electron-icon": "node scripts/sync-electron-dev-icon.mjs",
    "sync:plugin-palettes": "node scripts/content/sync-plugin-palettes.mjs",
    "fix:keychain": "node scripts/reset-dev-keychain.mjs",
    "postinstall": "electron-builder install-app-deps && bun run sync:electron-icon",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux",
    "test": "node --import ./scripts/test-loader.mjs --test --test-timeout=300000 --test-force-exit tests/*.test.ts",
    "test:packages": "node --import ./scripts/test-loader.mjs --test --test-timeout=300000 --test-force-exit tests/package-content/*.test.ts",
    "test:runtime": "PHI_RUNTIME_INTEGRATION=1 node --import ./scripts/test-loader.mjs --test tests/runtime/*.test.ts tests/envs-*.test.ts",
    "test:helper": "bun run helper:fetch-go && node scripts/helper-toolchain.mjs test ./... && node scripts/helper-toolchain.mjs vet ./...",
    "smoke:wrappers": "node --import ./scripts/test-loader.mjs scripts/smoke-wrappers.mjs",
    "smoke:terminal-host": "bun scripts/terminal-host-smoke.ts",
    "smoke:terminal-manager": "bun scripts/terminal-manager-smoke.ts",
    "smoke:terminal-stress": "bun scripts/terminal-stress-smoke.ts",
    "smoke:terminal-packaged": "bun scripts/terminal-packaged-smoke.ts",
    "smoke:packaged-quit": "node scripts/smoke-packaged-quit.mjs",
    "runtime:fetch": "node scripts/runtime/fetch-micromamba.mjs",
    "helper:fetch-go": "node scripts/runtime/fetch-go.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "office:fetch": "node scripts/office/fetch-officecli.mjs",
    "office:smoke": "bun run scripts/office/smoke-preview.ts",
    "office:smoke:app": "bunx electron-vite build && bun run scripts/office/smoke-app.ts && bun run scripts/office/smoke-app-restart.ts && bun run scripts/office/smoke-app-import.ts && bun run scripts/office/smoke-app-docx.ts && bun run scripts/office/smoke-app-pptx.ts && bun run scripts/office/smoke-app-deliver.ts && bun run scripts/office/smoke-app-highlight.ts && bun run scripts/office/smoke-app-export.ts",
    "office:smoke:app:import": "bunx electron-vite build && bun run scripts/office/smoke-app-import.ts",
    "office:smoke:app:deliver": "bunx electron-vite build && bun run scripts/office/smoke-app-deliver.ts",
    "office:smoke:app:docx": "bunx electron-vite build && bun run scripts/office/smoke-app-docx.ts",
    "office:smoke:app:highlight": "bunx electron-vite build && bun run scripts/office/smoke-app-highlight.ts",
    "office:smoke:app:export": "bunx electron-vite build && bun run scripts/office/smoke-app-export.ts",
    "office:smoke:app:pptx": "bunx electron-vite build && bun run scripts/office/smoke-app-pptx.ts",
    "office:smoke:app:plugin": "bunx electron-vite build && bun run scripts/office/smoke-app-office-plugin.ts",
    "office:smoke:restart": "bunx electron-vite build && bun run scripts/office/smoke-app-restart.ts",
    "runtime:lock": "node --import ./scripts/test-loader.mjs scripts/runtime/lock-env.ts",
    "runtime:smoke": "node --import ./scripts/test-loader.mjs scripts/runtime/smoke-env.ts",
    "runtime:smoke:viz": "node --import ./scripts/test-loader.mjs scripts/runtime/smoke-viz.ts",
    "runtime:smoke:app:viz": "bunx electron-vite build && bun run scripts/runtime/smoke-app-viz-env.ts",
    "registry:build": "node --import ./scripts/test-loader.mjs scripts/packages/build-registry.ts",
    "registry:keygen": "node --import ./scripts/test-loader.mjs scripts/packages/generate-registry-key.ts",
    "registry:sign": "node --import ./scripts/test-loader.mjs scripts/packages/sign-registry.ts",
    "usage:report": "node --import ./scripts/test-loader.mjs scripts/agent-usage-report.mjs",
    "eval:fetch": "bun scripts/eval/db-vs-fetch.ts",
    "spike:terminal-pty": "bun scripts/terminal-pty-spike.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@mui/material": "^9.4.0",
    "@oh-my-pi/pi-coding-agent": "18.1.10",
    "@oh-my-pi/pi-natives": "18.1.10",
    "@rdkit/rdkit": "^2026.3.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.11.6",
    "ajv": "^8.20.0",
    "cytoscape": "^3.34.3",
    "glob": "13.0.6",
    "katex": "^0.18.7",
    "material-icon-theme": "^5.38.1",
    "molstar": "^5.11.0",
    "plotly.js-dist-min": "^4.1.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "^7.8.5",
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "trustedDependencies": [
    "protobufjs",
    "electron"
  ]
}
